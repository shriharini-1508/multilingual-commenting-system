# Multilingual Commenting & Subscription Platform Environment Configuration
PORT=5000

# MongoDB Atlas Connection URI (Replace with your Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/subscription_system?retryWrites=true&w=majority&appName=Cluster0

# Razorpay Payment Gateway Credentials (Test Keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Frontend Application Origin
FRONTEND_URL=http://localhost:5174

