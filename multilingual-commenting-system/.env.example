# Multilingual Commenting & Subscription Platform Environment Configuration
PORT=5000

# MongoDB Atlas Connection URI Options:
# Option A (Standard SRV):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.lslab9n.mongodb.net/subscription_system?retryWrites=true&w=majority&appName=Cluster0
# Option B (Direct Multi-Host Replica-Set - Recommended for Cloud Hosts without SRV/IPv6 support):
# MONGO_URI=mongodb://<username>:<password>@ac-opuscjt-shard-00-00.lslab9n.mongodb.net:27017,ac-opuscjt-shard-00-01.lslab9n.mongodb.net:27017,ac-opuscjt-shard-00-02.lslab9n.mongodb.net:27017/subscription_system?ssl=true&replicaSet=atlas-3e9yys-shard-0&authSource=admin&retryWrites=true&w=majority

# Razorpay Payment Gateway Credentials (Test Keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Frontend Application Origin
FRONTEND_URL=http://localhost:5174

